<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>クリックゲーム</title>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: sans-serif;
    background: #f3f6fb;
    color: #222;
  }

  .game {
    width: min(600px, 92%);
    margin: 60px auto;
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    text-align: center;
  }

  h1 {
    margin-top: 0;
  }

  .status {
    display: flex;
    justify-content: space-around;
    margin: 25px 0;
  }

  .status-box {
    background: #f5f7fa;
    padding: 15px 30px;
    border-radius: 12px;
  }

  .number {
    display: block;
    font-size: 28px;
    font-weight: bold;
    color: #2563eb;
  }

  #target {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: none;
    background: #2563eb;
    color: white;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    transition: transform .08s;
  }

  #target:hover {
    transform: scale(1.05);
  }

  #target:active {
    transform: scale(.9);
  }

  #start {
    margin-top: 25px;
    padding: 12px 30px;
    border: none;
    border-radius: 10px;
    background: #111827;
    color: white;
    font-size: 16px;
    cursor: pointer;
  }

  #start:hover {
    background: #374151;
  }

  #message {
    height: 30px;
    margin-top: 20px;
    font-weight: bold;
  }
</style>
</head>

<body>

<div class="game">

  <h1>🎮 クリックゲーム</h1>
  <p>30秒以内にボタンをできるだけクリック！</p>

  <div class="status">
    <div class="status-box">
      スコア
      <span id="score" class="number">0</span>
    </div>

    <div class="status-box">
      残り時間
      <span id="time" class="number">30</span>
    </div>
  </div>

  <button id="target" disabled>CLICK!</button>

  <div>
    <button id="start">ゲームスタート</button>
  </div>

  <div id="message"></div>

</div>

<script>
  const target = document.getElementById("target");
  const start = document.getElementById("start");
  const scoreText = document.getElementById("score");
  const timeText = document.getElementById("time");
  const message = document.getElementById("message");

  let score = 0;
  let time = 30;
  let timer = null;
  let playing = false;

  start.addEventListener("click", () => {
    score = 0;
    time = 30;
    playing = true;

    scoreText.textContent = score;
    timeText.textContent = time;
    message.textContent = "";

    target.disabled = false;
    start.disabled = true;

    timer = setInterval(() => {
      time--;
      timeText.textContent = time;

      if (time <= 0) {
        endGame();
      }
    }, 1000);
  });

  target.addEventListener("click", () => {
    if (!playing) return;

    score++;
    scoreText.textContent = score;

    // ボタンの色をランダムに変更
    const colors = [
      "#2563eb",
      "#7c3aed",
      "#db2777",
      "#059669",
      "#ea580c"
    ];

    target.style.background =
      colors[Math.floor(Math.random() * colors.length)];
  });

  function endGame() {
    clearInterval(timer);

    playing = false;
    target.disabled = true;
    start.disabled = false;

    message.textContent =
      `🎉 終了！あなたのスコアは ${score} 回です！`;
  }
</script>

</body>
</html>
